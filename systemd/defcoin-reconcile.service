[Unit]
Description=Defcoin pool blocksConfirmed reconciliation (re-verify against live chain)
After=defcoind.service redis-server.service
Requires=defcoind.service

[Service]
Type=oneshot
User=defcoin
Group=defcoin
WorkingDirectory=/home/defcoin
ExecStart=/usr/bin/python3 /home/defcoin/scripts/reconcile-blocksConfirmed.py --apply
StandardOutput=append:/var/log/defcoin-reconcile.log
StandardError=append:/var/log/defcoin-reconcile.log
